{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./*"],
			"@ariclear/components": ["./app/components"],
			"@ariclear/components/*": ["./app/components/*"],
			"@ariclear/lib": ["./lib"],
			"@ariclear/lib/*": ["./lib/*"],
			"@/app/*": ["./app/*"],
			"@/lib/*": ["./lib/*"],
			"@/lib": ["./lib"],
			"@/helpers/*": ["./helpers/*"],
			"@/helpers": ["./helpers"],
			"@/components/*": ["./app/components/*"],
			"@/remotion/*": ["./remotion/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	"exclude": ["node_modules"]
}

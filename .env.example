# AriClear environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are shipped to the browser; everything else is server-only.

# ─── Site ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash: canonical URLs, sitemap, Stripe redirects.
# Optional: falls back to NEXT_PUBLIC_SITE_URL. Production: https://www.ariclear.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used by auth emails (verify / reset). Usually the same as NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=

# ─── Supabase: app project ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_ARI_CLEAR_URL=
NEXT_PUBLIC_SUPABASE_ARI_CLEAR_ANON_KEY=
# Server only. Bypasses RLS (entitlements, scan claims, purchases, plan requests).
SUPABASE_ARI_CLEAR_SERVICE_ROLE_KEY=

# ─── Supabase: mail project (waitlist) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_MAIL_URL=
SUPABASE_MAIL_SERVICE_ROLE_KEY=

# ─── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Only for the parked brand-awareness route.
ANTHROPIC_API_KEY=
# Optional. Claude model for brand awareness (default: claude-opus-5-5).
ANTHROPIC_BRAND_MODEL=
# Optional. Site-wide daily cap on free homepage demo scans (default: 1000).
DEMO_DAILY_CAP=

# ─── Stripe (one-time 6-month plans) ───────────────────────────────────────────
# Test mode keys start with sk_test_ / whsec_ ; use live keys only in production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# One-time Price IDs (price_...) from the Stripe dashboard
STRIPE_PRICE_GLADIATOR=
STRIPE_PRICE_CENTURION=

# ─── Rate limiting (optional) ──────────────────────────────────────────────────
# If set, limits are kept in Upstash Redis. If not, they are kept in Supabase
# (rate_limit_hit(), needs SUPABASE_ARI_CLEAR_SERVICE_ROLE_KEY). In-memory only
# when neither is available (local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error | silent. Default: info in production, debug otherwise.
LOG_LEVEL=

# ─── Scheduled re-scan (Vercel Cron, see vercel.json) ──────────────────────────
# Required for /api/cron/rescan to run. Vercel sends it as a Bearer token.
CRON_SECRET=
# Optional: sites per run (default 10, max 50) and days between re-scans (default 7).
RESCAN_BATCH=
RESCAN_MIN_AGE_DAYS=

# ─── Email (score digest) ──────────────────────────────────────────────────────
# Unset = no email is sent. "log" = development only (logs the subject).
# A real provider is added once chosen.
EMAIL_PROVIDER=
# Signs one-click unsubscribe links. Falls back to CRON_SECRET.
EMAIL_SIGNING_SECRET=
